# Port the Express server listens on (default 3000).
PORT=3000

# Bearer token required on /api/audit, /api/capture, and /api/relay (mandatory >= 32 chars when NODE_ENV=production; e.g. `openssl rand -hex 32`).
CAPTURE_TOKEN=

# Optional path to Chromium binary (falls back to /usr/bin/chromium and system paths).
PLAYWRIGHT_EXECUTABLE_PATH=

# Set to true only when deployed behind a trusted reverse proxy so X-Forwarded-For sets client IP.
TRUST_PROXY=false

# Optional comma-separated hostnames allowed by /api/relay (defaults to openrouter.ai,integrate.api.nvidia.com).
RELAY_ALLOWED_HOSTS=

# Optional local Ollama base URL for server-side model discovery & chat bridge (defaults to http://127.0.0.1:11434).
OLLAMA_URL=http://127.0.0.1:11434

# Optional shared TourForge server URL used by CLI/MCP agents (e.g. http://127.0.0.1:3000; runs in-process when omitted).
TOURFORGE_SERVER_URL=
